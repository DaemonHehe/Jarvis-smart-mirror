# MSI backend network
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_CORS_ORIGINS=http://localhost:8000

# Mirror content sent to the Pi browser. URLs are fetched by the MSI backend.
JARVIS_MIRROR_LOCALE=en-GB
JARVIS_LOCATION_NAME=Bangkok
JARVIS_WEATHER_LATITUDE=13.7563
JARVIS_WEATHER_LONGITUDE=100.5018
JARVIS_NEWS_FEED_URL=https://feeds.bbci.co.uk/news/world/rss.xml
JARVIS_CALENDAR_URL=
JARVIS_NIGHT_START_HOUR=23
JARVIS_NIGHT_END_HOUR=6

# Conversation provider: local or gemini-live
JARVIS_CONVERSATION_PROVIDER=local
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=
GEMINI_FALLBACK_COOLDOWN_SECONDS=60
JARVIS_FOLLOWUP_TIMEOUT_SECONDS=10

# Local fallback
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=-1
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
EDGE_TTS_VOICE=en-US-GuyNeural
